# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variables de entorno: NUNCA se suben a Git (contienen claves secretas)
.env
.env.local
.env*.local
.env.development
.env.production
# Base de PRUEBAS para npm run test:e2e (también tiene claves)
.env.e2e
# ...excepto las plantillas sin secretos
!.env.example
!.env.e2e.example

# Credenciales de Google (por si alguien guarda el archivo JSON aquí)
*service-account*.json
credenciales*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pruebas de punta a punta (Playwright)
/.next-e2e/
/test-results/
/playwright-report/
/tests/e2e/.auth/
*.key
*private-key*.json
