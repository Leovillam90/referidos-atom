# =====================================================================
#  Referidos ATOM — Plantilla de variables de entorno
# ---------------------------------------------------------------------
#  1. Copia este archivo y nómbralo  .env.local
#  2. Llena los valores reales en .env.local (NUNCA en este archivo).
#  3. .env.local no se sube a Git: está en .gitignore.
#
#  Las variables que empiezan por NEXT_PUBLIC_ son visibles en el
#  navegador. TODAS las demás solo existen en el servidor.
# =====================================================================

# --- Sitio ------------------------------------------------------------
# Dirección pública de la app. En tu computador: http://localhost:3000
# En producción: tu dominio, por ejemplo https://referidos.atom.com.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública ("Publishable key", empieza por sb_publishable_...).
# Si tu proyecto muestra la clave antigua "anon", también sirve.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Clave SECRETA ("Secret key", empieza por sb_secret_...; o la antigua
# "service_role"). Salta las reglas de seguridad: SOLO servidor.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# OPCIONAL. Solo para que /admin/estado y "npm run verificar" comparen
# NEXT_PUBLIC_SITE_URL con la Site URL de Supabase Auth. Es un token
# personal: supabase.com → Account → Access Tokens. Es SECRETO.
# Si lo dejas vacío, la revisión te dice qué comprobar a mano.
SUPABASE_ACCESS_TOKEN=

# --- Google Sheets (cuenta de servicio, solo lectura) -----------------
# Del archivo JSON de la cuenta de servicio: campo "client_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL=referidos-atom@tu-proyecto.iam.gserviceaccount.com
# Del mismo JSON: campo "private_key". Pégalo entre comillas dobles,
# tal cual, con los \n incluidos.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"
# ID de la hoja: la parte de la URL entre /d/ y /edit
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# Nombre de la pestaña (y opcionalmente el rango) donde están los afiliados.
# La primera fila debe tener los títulos de las columnas.
GOOGLE_SHEET_RANGE=Afiliados

# --- Nombres de las columnas en la hoja --------------------------------
# Escríbelos EXACTAMENTE como aparecen en la primera fila de la hoja
# (no importan mayúsculas/minúsculas ni espacios al inicio o final).
SHEET_COL_CORREO=Correo
SHEET_COL_TELEFONO=Telefono
SHEET_COL_PLAN=Plan
# (El valor del bono ya no sale de la hoja: sale de la tabla "planes" en Supabase.)

# --- Cruce automático diario (Vercel Cron) -----------------------------
# Clave larga y aleatoria que protege la dirección /api/cruce.
# Para generarla, en la terminal de VS Code:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Correos al referente (SMTP) ---------------------------------------
# Datos del servidor de correo de notificaciones@atomapp.com.co. Te los da
# tu proveedor (Google Workspace, Microsoft 365, Zoho, Resend, Brevo...).
# Si SMTP_HOST queda vacío, la app funciona pero no envía correos.
SMTP_HOST=
# 587 (STARTTLS, lo más común) o 465 (SSL)
SMTP_PORT=587
SMTP_USER=notificaciones@atomapp.com.co
# Contraseña (o "contraseña de aplicación") del correo. SOLO aquí y en Vercel.
SMTP_PASSWORD=
SMTP_FROM="ATOM Referidos <notificaciones@atomapp.com.co>"

# --- Página de gracias del referido ------------------------------------
# Paso 1: link de registro en ATOM dentro de Dropi
LINK_DROPI_ATOM=
# Paso 2: lista de videos de activación
LINK_VIDEOS_ACTIVACION=https://www.youtube.com/playlist?list=PLJxe4Q_nt4qE
# Paso 3: números de WhatsApp para la capacitación, separados por coma
WHATSAPP_CAPACITACION=573122521130,573189762642

# --- Autorización de datos (Ley 1581 de 2012) --------------------------
# Versión de la política de tratamiento de datos que acepta el referido.
# Cámbiala cuando actualices el texto, para saber qué versión aceptó cada uno.
POLITICA_DATOS_VERSION=2026-11-v1
# Link del documento oficial de la política (PDF o página). Si se llena,
# el link del formulario lleva ahí. Si queda vacío, se usa /politica-datos.
POLITICA_DATOS_URL=
